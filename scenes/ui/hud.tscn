[node name="Help" type="Label" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -12.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"HudPanelDim"
text = "出牌　拖曳手牌到地圖，或按 F1～F4 拿起卡再點地圖
選取　左鍵點選／拖曳框選，Shift 加選
移動　右鍵；點敵人攻擊；點己方運兵車上車
強制攻擊　Ctrl＋右鍵
編組　Ctrl＋1～9 存、1～9 叫出（連按兩下跳過去）
隊形　Z 橫排／C 三角／V 縱列（再按一次取消）
H 駐守　X 停止　R 撤退（退回一半費用）
U 下車　B 工兵炸橋／修橋
鏡頭　滾輪縮放；中鍵或空白鍵＋左鍵拖曳；WASD／方向鍵／邊緣捲動
G 格線　F 全圖　F10 收起說明"

